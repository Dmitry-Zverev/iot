        "z": "tab-kitchen"
    },
    {
        "id": "fn-temp",
        "type": "function",
        "name": "в число",
        "func": "// Из MQTT payload приходит строкой. Приводим к числу и отбрасываем мусор.\nconst value = parseFloat(msg.payload);\nif (Number.isNaN(value)) {\n    node.warn(`Не число: ${msg.payload}`);\n    return null;   // null = сообщение дальше не пойдёт\n}\nmsg.payload = Math.round(value * 10) / 10;\nmsg.topic = 'Температура';\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 100,
        "wires": [
            [
                "gauge-temp",
                "chart-climate",
                "dbg-temp"
            ]
        ],
        "z": "tab-kitchen"
    },
