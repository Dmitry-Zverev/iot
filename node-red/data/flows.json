    {
        "id": "fn-fake",
        "type": "function",
        "name": "сгенерировать температуру",
        "func": "// Публикуем правдоподобную температуру прямо из Node-RED —\n// удобно, пока ESP32 ещё едет с маркетплейса.\nlet t = context.get('t') ?? 22;\nt += (Math.random() - 0.5) * 0.6;\nt = Math.min(30, Math.max(15, t));\ncontext.set('t', t);\n\nreturn { topic: 'home/kitchen/temperature', payload: t.toFixed(2), retain: true };",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 220,
        "wires": [
