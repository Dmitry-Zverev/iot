    {
        "id": "fn-hello",
        "type": "function",
        "name": "обычный JS",
        "func": "// Это Node.js. Всё, что ты знаешь про JS, работает здесь.\nconst t = parseFloat(msg.payload);\n\n// node.warn() — печать в правую панель «Отладка»\nnode.warn(`Пришло: ${t}`);\n\n// Состояние между вызовами живёт в context\nconst count = (context.get('count') || 0) + 1;\ncontext.set('count', count);\n\nmsg.payload = { температура: t, жарко: t > 25, вызов: count };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 100,
        "wires": [
            [
                "dbg-hello"
            ]
        ],
        "z": "tab-sandbox"
    },
