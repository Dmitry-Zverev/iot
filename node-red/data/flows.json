    {
        "id": "inj-hello",
        "type": "inject",
        "name": "нажми меня",
        "props": [
            {
                "p": "payload"
            },
            {
                "p": "topic",
                "vt": "str"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "22.7",
        "payloadType": "str",
