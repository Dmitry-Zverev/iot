        "id": "mqtt-temp",
        "type": "mqtt in",
        "name": "🌡 температура",
        "topic": "home/kitchen/temperature",
        "qos": "0",
        "datatype": "auto-detect",
        "broker": "broker-mosquitto",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
