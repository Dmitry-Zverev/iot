# Скопируй в secrets.yaml и заполни. secrets.yaml в git не попадает.
wifi_ssid: "MyWiFi"
wifi_password: "wifi-password"

# IP машины, где запущен docker compose. Узнать:
#   Windows: ipconfig     (IPv4-адрес)
#   macOS:   ipconfig getifaddr en0
# localhost/127.0.0.1 НЕ РАБОТАЕТ — для ESP32 это он сам.
mqtt_broker: "192.168.1.50"
mqtt_user: "iot"
mqtt_password: "возьми MQTT_PASSWORD из .env"

ota_password: "любой-пароль-для-обновлений-по-воздуху"
